# --- Postgres из docker-compose.yml -----------------------------------------
# Эти переменные читает и сам контейнер, и строки подключения ниже.
POSTGRES_USER=boom
POSTGRES_PASSWORD=boom
POSTGRES_DB=boom
POSTGRES_PORT=5432

# Хост — именно 127.0.0.1, а не localhost: на Windows localhost резолвится
# в IPv6 ::1, куда проброс портов Docker Desktop не отвечает, и движок Prisma
# падает с P1001 «Can't reach database server».
# Рантайм-подключение (pg Pool в PrismaService)
DATABASE_URL="postgresql://boom:boom@127.0.0.1:5432/boom?schema=public"
# Подключение для CLI Prisma: миграции, prisma studio (prisma7.config.ts)
DIRECT_URL="postgresql://boom:boom@127.0.0.1:5432/boom?schema=public"

# --- NestJS ------------------------------------------------------------------
PORT=5151
NODE_ENV=development

# Через запятую. Если не задать — CORS открыт для любого origin.
# CORS_ORIGIN=http://localhost:3000
