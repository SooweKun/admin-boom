PORT=5151

POSTGRES_USER=boom
POSTGRES_PASSWORD=boom
POSTGRES_DB=boom
POSTGRES_PORT=5432

# Используется приложением (Prisma driver adapter)
DATABASE_URL=postgresql://boom:boom@localhost:5432/boom
# Используется Prisma CLI (миграции)
DIRECT_URL=postgresql://boom:boom@localhost:5432/boom

# Авторизация админки. Все три обязательны: без них бэк не стартует.
# Админ один, логин и пароль сверяются с этими значениями.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
# Секрет подписи JWT. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me
